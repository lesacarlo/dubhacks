# Keep this secret server-side. The app shows an honest retry state without it.
OPENAI_API_KEY=
# ID of the saved agent in the OpenAI Platform (server-side only).
OPENAI_AGENT_ID=
# A tool-capable Responses API model available to your account.
OPENAI_MODEL=gpt-4.1-mini
# Hosted Supabase development project. Never use these in browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Server-only signing material for anonymous, httpOnly session cookies (32+ random characters).
SESSION_SECRET=
